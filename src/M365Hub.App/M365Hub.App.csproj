<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Version>1.0.6</Version>
    <!-- 1.0.6: 关掉 SDK 自带的自动初始化（它会在缺 runtime 时弹框架的
         “需要安装 Windows App Runtime”框），改由 RuntimeBootstrap.cs
         显式自举：先试本机 1.6，没有就静默跑自带的安装器。 -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <RootNamespace>M365Hub.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <!-- One package covers both CPUs: build with -r win-x64 or -r win-arm64.
         The right gateway exe (m365hub.exe / m365hub-arm64.exe) is picked
         at runtime from RuntimeInformation.OSArchitecture. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- App icon (Designer__4.png): embedded in the exe and shown on the window. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.240923002" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\M365Hub.Core\M365Hub.Core.csproj" />
  </ItemGroup>

  <!-- Ship both gateway binaries next to the app. -->
  <ItemGroup>
    <None Include="..\..\gateway\m365hub.exe" Link="m365hub.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\gateway\m365hub-arm64.exe" Link="m365hub-arm64.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
