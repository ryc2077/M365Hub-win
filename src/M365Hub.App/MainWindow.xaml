<Window
    x:Class="M365Hub.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="M365Hub">

    <Grid x:Name="RootGrid">
        <controls:NavigationView x:Name="Nav"
                IsSettingsVisible="False"
                PaneDisplayMode="Left"
                OpenPaneLength="280"
                SelectionChanged="Nav_SelectionChanged">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem Content="聊天" Tag="chat" Icon="Message" />
                <controls:NavigationViewItem Content="仪表盘" Tag="dashboard" Icon="Home" />
                <controls:NavigationViewItem Content="账号" Tag="accounts" Icon="Contact" />
                <controls:NavigationViewItem Content="模型" Tag="models" Icon="Library" />
                <controls:NavigationViewItem Content="用量" Tag="usage" Icon="Chart" />
                <controls:NavigationViewItem Content="代理" Tag="proxies" Icon="Globe" />
                <controls:NavigationViewItem Content="对话" Tag="conversations" Icon="ChatBubbles" />
                <controls:NavigationViewItem Content="本地记忆" Tag="memory" Icon="Bookmarks" />
                <controls:NavigationViewItem Content="设置" Tag="settings" Icon="Setting" />
            </controls:NavigationView.MenuItems>
            <controls:NavigationView.PaneFooter>
                <StackPanel Margin="12,0,12,12" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="NewChatBtn" Content="＋ 新对话" Click="NewChat_Click" />
                        <Button x:Name="ThemeBtn" Content="🌙" Click="Theme_Click" />
                    </StackPanel>
                    <ListView x:Name="HistoryList" MaxHeight="300"
                            SelectionChanged="History_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Content="×" Click="HistoryDelete_Click"
                                            Tag="{Binding Id}" Padding="6,0,6,0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </controls:NavigationView.PaneFooter>
            <Grid x:Name="PageHost" />
        </controls:NavigationView>

        <!-- Startup / failure overlay -->
        <Grid x:Name="StartupOverlay" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="12" Width="420">
                <TextBlock Text="M365Hub" FontSize="28" FontWeight="Bold" />
                <TextBlock x:Name="StartupStatus" Text="正在启动本地网关…" TextWrapping="Wrap" />
                <StackPanel x:Name="StartupButtons" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <Button x:Name="RetryBtn" Content="重试启动" Click="Retry_Click" />
                    <Button x:Name="LogBtn" Content="查看网关日志" Click="Log_Click" />
                </StackPanel>
                <ScrollViewer x:Name="LogView" MaxHeight="300" Visibility="Collapsed">
                    <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
